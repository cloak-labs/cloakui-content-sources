{
  "name": "@cloakui/content-sources",
  "version": "0.4.0",
  "description": "Register and look up content sources (CMS backends) with URLs, paths, and clients via a shared singleton registry.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "require": "./dist/index.js",
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "dev": "tsc -p tsconfig.json -w --preserveWatchOutput",
    "build": "npm run build-ts",
    "build-ts": "tsc -p tsconfig.json",
    "clean": "rm -rf .turbo && rm -rf dist",
    "clean:modules": "rm -rf node_modules",
    "zzz-postpublish": "git push && git push --tags",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check ."
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cloak-labs/cloakui-content-sources.git"
  },
  "keywords": [
    "content-sources",
    "cms",
    "headless cms",
    "cloakui",
    "headless",
    "decoupled",
    "registry"
  ],
  "author": "Kaelan Smith",
  "license": "LGPL-3.0-only",
  "bugs": {
    "url": "https://github.com/cloak-labs/cloakui-content-sources/issues"
  },
  "homepage": "https://github.com/cloak-labs/cloakui-content-sources#readme",
  "dependencies": {
    "@kaelan/with-plugins": "^0.0.2"
  },
  "devDependencies": {
    "@types/node": "^18.19.130",
    "typescript": "7.0.2",
    "oxfmt": "0.71.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
